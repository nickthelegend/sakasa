{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@iwsdk/vite-plugin-dev/client"],
    "baseUrl": ".",
    "paths": { "@sakasa/core": ["../core/src/index.ts"] }
  },
  "include": ["src/**/*.ts"]
}
