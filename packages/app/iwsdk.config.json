{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true,
        "anchors": true,
        "planeDetection": true,
        "meshDetection": true,
        "gazeTracking": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 70,
      "near": 0.001,
      "far": 200,
      "camera": {
        "position": [
          0,
          1.6,
          1
        ],
        "lookAt": [
          0,
          0.95,
          -1.95
        ]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": true,
      "physics": true,
      "sceneUnderstanding": true,
      "environmentRaycast": false,
      "spatialUI": {
        "kit": "horizon",
        "preferredColorScheme": "dark"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "open_studio"
    }
  }
}
